# K.I.N.G.S. cross-platform runtime configuration
KINGS_CODING_MACHINE_PORT=8787
KINGS_CODING_MACHINE_BIND=127.0.0.1
# Required whenever KINGS_CODING_MACHINE_BIND is not loopback. Use at least
# 24 random characters and terminate remote/mobile access behind trusted HTTPS.
# Android/mobile bootstrap sends the token in POST /session/bootstrap; the server
# returns a Secure HttpOnly SameSite=Strict session cookie. Never commit the token.
KINGS_CODING_MACHINE_TOKEN=
KINGS_CODING_MACHINE_OLLAMA_URL=http://127.0.0.1:11434

# Authenticated owner-console engineering controls derive build/test commands only
# from this server-configured repository. Browser/API requests cannot override the
# workspace, executable, command, or arguments. Empty means the K.I.N.G.S. cwd.
KINGS_CODING_MACHINE_WORKSPACE=
# Optional stable project label used in readiness/verification evidence.
KINGS_CODING_MACHINE_PROJECT_ID=
# Per repository-native build/test step. Allowed range: 1000 through 600000 ms.
KINGS_CODING_MACHINE_VERIFY_TIMEOUT_MS=120000

# K.I.N.G.S. independent inference: own agent/runtime, no outside AI agents.
# Sovereign is the default; no external gateways are registered for inference.
# "hybrid" is an explicit opt-in and is NOT the independent K.I.N.G.S. deployment.
KINGS_INTELLIGENCE_MODE=sovereign
# Connect an owner-operated, local or private-network inference server.
# Actual model weights must be supplied, licensed/trained, tested and benchmarked.
KINGS_OLLAMA_BASE_URL=http://127.0.0.1:11434
KINGS_OLLAMA_MODEL=
# Declare only capabilities verified for the exact local model.
KINGS_OLLAMA_CAPABILITIES=reasoning,planning,coding,debugging,research,source-inspection,verification,recovery
# Optional context budget: actual server-side Ollama num_ctx, 1024..131072.
# Increasing this requires real model and RAM/VRAM support.
KINGS_OLLAMA_CONTEXT_TOKENS=32768
# Optional exact owner-approved private inference hostname(s).
KINGS_SOVEREIGN_INFERENCE_HOSTS=

# Shared app-facing K.I.N.G.S. AI router.
# Keep this on loopback unless a bearer token is configured.
KINGS_APP_ROUTER_PORT=8790
KINGS_APP_ROUTER_BIND=127.0.0.1
KINGS_APP_ROUTER_TOKEN=
KINGS_APP_ROUTER_PROVIDER_ORDER=ollama-internal

# Governed child-app research limits. Research retrieval is HTTPS GET only,
# bounded, redirect-free, and blocks private-network targets by default.
KINGS_APP_RESEARCH_MAX_SOURCES=8
KINGS_APP_RESEARCH_MAX_RESPONSE_BYTES=524288
KINGS_APP_RESEARCH_TIMEOUT_MS=15000
# Optional comma-separated hostname allowlist. Empty means public HTTPS hosts
# remain subject to the normal WebAccess policy rather than an app-specific list.
KINGS_APP_RESEARCH_ALLOWED_HOSTS=

# External routes below are inert in sovereign mode. Only explicit owner opt-in
# KINGS_INTELLIGENCE_MODE=hybrid enables outside AI model providers.
# OmniRoute (OpenAI-compatible). Keep keys out of git.
KINGS_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
KINGS_OMNIROUTE_API_KEY=
KINGS_OMNIROUTE_MODELS=auto/coding,auto/cheap
# Render/private-network deployments may provide host:port instead of a URL.
KINGS_OMNIROUTE_HOSTPORT=
# Set true only when you explicitly want to bypass OmniRoute cache.
KINGS_OMNIROUTE_NO_CACHE=false

# 9Router (OpenAI-compatible)
# If OmniRoute and 9Router run on different machines/ports, set them independently.
KINGS_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
KINGS_9ROUTER_API_KEY=
KINGS_9ROUTER_MODELS=auto
KINGS_9ROUTER_HOSTPORT=

KINGS_CONNECTOR_HEALTH_TIMEOUT_MS=1500
