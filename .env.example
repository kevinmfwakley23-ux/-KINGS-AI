# K.I.N.G.S. Mega Brain / Coding Machine configuration
# Copy to .env only in a local environment. Never commit real provider keys.

# Shared durable state
KINGS_STATE_ROOT=.kings
KINGS_GATEWAY_USAGE_FILE=.kings/gateway-usage.jsonl
KINGS_ROUTING_METRICS_FILE=.kings/routing-metrics.json

# Cross-app Mega Brain HTTP service
KINGS_APP_ROUTER_BIND=127.0.0.1
KINGS_APP_ROUTER_PORT=8790
# Required whenever KINGS_APP_ROUTER_BIND is not loopback.
KINGS_APP_ROUTER_TOKEN=
KINGS_APP_ROUTER_MAX_BODY_BYTES=1048576

# Governed cross-app research
KINGS_APP_RESEARCH_MAX_SOURCES=8
KINGS_APP_RESEARCH_MAX_RESPONSE_BYTES=524288
KINGS_APP_RESEARCH_TIMEOUT_MS=15000
# Optional comma-separated allow-list. Empty means the WebAccess authority may
# reach public HTTPS hosts subject to its private-network and method restrictions.
KINGS_APP_RESEARCH_ALLOWED_HOSTS=

# OmniRoute
KINGS_OMNIROUTE_URL=
KINGS_OMNIROUTE_KEY=
KINGS_OMNIROUTE_MODELS=auto/coding,auto

# 9Router
KINGS_9ROUTER_URL=
KINGS_9ROUTER_KEY=
KINGS_9ROUTER_MODELS=

# Local/self-hosted OpenAI-compatible gateway
KINGS_LOCAL_OPENAI_URL=
KINGS_LOCAL_OPENAI_KEY=
KINGS_LOCAL_OPENAI_MODELS=
KINGS_LOCAL_OPENAI_NAME=Local OpenAI-Compatible AI

# OpenRouter
KINGS_OPENROUTER_KEY=
KINGS_OPENROUTER_URL=https://openrouter.ai/api
KINGS_OPENROUTER_MODELS=openrouter/free

# Groq
KINGS_GROQ_KEY=
KINGS_GROQ_URL=https://api.groq.com/openai
KINGS_GROQ_MODELS=

# Cerebras
KINGS_CEREBRAS_KEY=
KINGS_CEREBRAS_URL=https://api.cerebras.ai
KINGS_CEREBRAS_MODELS=

# Mistral
KINGS_MISTRAL_KEY=
KINGS_MISTRAL_URL=https://api.mistral.ai
KINGS_MISTRAL_MODELS=

# Chutes
KINGS_CHUTES_KEY=
KINGS_CHUTES_URL=https://llm.chutes.ai
KINGS_CHUTES_MODELS=

# Together AI
KINGS_TOGETHER_KEY=
KINGS_TOGETHER_URL=https://api.together.ai
KINGS_TOGETHER_MODELS=

# Fireworks AI
KINGS_FIREWORKS_KEY=
KINGS_FIREWORKS_URL=https://api.fireworks.ai/inference
KINGS_FIREWORKS_MODELS=

# Optional JSON array of additional OpenAI-compatible gateway definitions.
# Example shape only; keep credentials out of tracked files.
KINGS_AI_GATEWAYS_JSON=

# Existing owner coding-machine runtime
KINGS_CODING_MACHINE_BIND=127.0.0.1
KINGS_CODING_MACHINE_PORT=8787
KINGS_CODING_MACHINE_HOST=localhost
KINGS_CODING_MACHINE_WORKSPACE=
KINGS_CODING_MACHINE_STATE=
KINGS_OWNER_TOKEN=

# Optional local Ollama fallback for the owner coding machine
KINGS_ENABLE_OLLAMA_FALLBACK=0
KINGS_CODING_MACHINE_OLLAMA_URL=http://127.0.0.1:11434
KINGS_CODING_MACHINE_MODEL=qwen2.5-coder:1.5b

# Repository execution controls
KINGS_BUILD_NETWORK=1
KINGS_DISABLE_HOST_ISOLATION=0
KINGS_BWRAP_PATH=
KINGS_MAX_JSON_BODY_BYTES=
