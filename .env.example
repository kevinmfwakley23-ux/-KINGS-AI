# K.I.N.G.S. cross-platform runtime configuration
KINGS_CODING_MACHINE_PORT=8787
KINGS_CODING_MACHINE_BIND=127.0.0.1

# Optional local fallback only. Leave blank unless you intentionally want a
# local Ollama connector visible in the owner console.
KINGS_CODING_MACHINE_OLLAMA_URL=

# Shared app-facing K.I.N.G.S. AI router.
# Keep this on loopback unless a bearer token is configured.
KINGS_APP_ROUTER_PORT=8790
KINGS_APP_ROUTER_BIND=127.0.0.1
KINGS_APP_ROUTER_TOKEN=
KINGS_APP_ROUTER_PROVIDER_ORDER=omniroute,9router

# Provider verification and request timeouts.
KINGS_CONNECTOR_HEALTH_TIMEOUT_MS=1500
KINGS_GATEWAY_REQUEST_TIMEOUT_MS=60000

# OmniRoute (OpenAI-compatible).
# Set the base URL only when OmniRoute is actually running. A common local URL
# is http://127.0.0.1:20128/v1. K.I.N.G.S. verifies /models before advertising
# the provider as available. Leave MODELS blank to prefer verified task-fit
# aliases such as auto/coding and auto/smart when the catalog exposes them.
KINGS_OMNIROUTE_BASE_URL=
KINGS_OMNIROUTE_API_KEY=
KINGS_OMNIROUTE_MODELS=
# Set true only when you explicitly want to bypass OmniRoute cache.
KINGS_OMNIROUTE_NO_CACHE=false

# 9Router (OpenAI-compatible).
# Set the base URL only when 9Router is actually running. 9Router commonly uses
# http://127.0.0.1:20128/v1 by default. If OmniRoute and 9Router run at the same
# time, configure them on different ports and put the real URLs below.
KINGS_9ROUTER_BASE_URL=
KINGS_9ROUTER_API_KEY=
KINGS_9ROUTER_MODELS=
