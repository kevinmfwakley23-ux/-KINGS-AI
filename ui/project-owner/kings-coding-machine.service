[Unit]
Description=KINGS Coding Machine local owner server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/KINGS-AI
Environment=KINGS_CODING_MACHINE_PORT=8787
Environment=KINGS_CODING_MACHINE_HOST=kings.local
Environment=KINGS_CODING_MACHINE_MODEL=qwen2.5-coder:1.5b
Environment=KINGS_CODING_MACHINE_WORKSPACE=%h/KINGS-AI
ExecStart=/usr/bin/env node %h/KINGS-AI/ui/project-owner/start-service.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
