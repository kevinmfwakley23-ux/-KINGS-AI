{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "./build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "core/workforce/**/*.ts",
    "runtimes/**/*.ts"
  ],
  "exclude": [
    "**/build/**",
    "**/node_modules/**"
  ]
}
