{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K.I.N.G.S. AI",
  "version": "1.0.0",
  "identifier": "ai.kings.owner",
  "build": {
    "frontendDist": "../native-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "K.I.N.G.S. AI",
        "width": 1100,
        "height": 760,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https:; navigate-to https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
